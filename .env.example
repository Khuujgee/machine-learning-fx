# Built-in scanner (free alternative to TradingView webhooks). true = also run it inside the FastAPI server.
SCANNER_ENABLED=false
SCANNER_DELAY_SEC=90
SCANNER_REFRESH_NEWS=true
MAX_OPEN_TRADES=8
MAX_TRADES_PER_CURRENCY=2

# Only needed for TradingView webhooks: long random string, must match "secret" in your alert JSON
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Only accept requests from TradingView's IPs (set TRUST_PROXY_HEADERS=true behind ngrok/cloudflared/nginx)
ENFORCE_IP_ALLOWLIST=false
TRUST_PROXY_HEADERS=false
MAX_ALERT_AGE_SEC=300

# News sources (comma-separated pages or RSS feeds) + CSS selector for headlines on HTML pages
NEWS_URLS=https://investinglive.com/feed/news,https://investinglive.com/feed/forex,https://investinglive.com/feed/centralbank
NEWS_HEADLINE_SELECTOR=article h1, article h2, article h3, h2 a, h3 a
NEWS_REFRESH_SEC=900

# Paper trading
STARTING_EQUITY=100000
RISK_PER_TRADE=0.01
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0
PROB_THRESHOLD=0.58
MAX_LEVERAGE=20
COST_BPS=1.0
REQUIRE_TV_AGREEMENT=true
ONE_POSITION_PER_PAIR=true
MONITOR_INTERVAL_SEC=60
